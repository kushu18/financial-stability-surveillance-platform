# ══════════════════════════════════════════════════════════════════════════════
# Financial Contagion Monitor v2 — .env.example
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# cp .env.example .env
# .env is gitignored — NEVER commit the actual .env file
# ══════════════════════════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING_DO_NOT_USE_THIS_DEFAULT
JWT_EXPIRY_HOURS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────────────────────
# For demo: add all laptop IPs on the LAN
# Find server IP: Windows -> ipconfig | Linux -> hostname -I
# Example multi-device: http://localhost:8050,http://192.168.1.100:8050
ALLOWED_ORIGINS=http://localhost:8050,http://127.0.0.1:8050

# ── Data Paths ────────────────────────────────────────────────────────────────
DATA_DIR=data/raw/
CACHE_DB=data/cache.db
SECURITY_DB=data/security/users.db

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# 8GB RAM  -> llama3.2:3b
# 16GB RAM -> mistral:7b  OR  llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MAX_TOKENS=600
OLLAMA_TEMPERATURE=0.3

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASH_PORT=8050
# 0.0.0.0 allows other devices on LAN to connect — required for multi-screen demo
DASH_HOST=0.0.0.0
# MUST be False for multi-user demo (debug=True uses single-threaded server)
DEBUG=False

# ── Live Data ─────────────────────────────────────────────────────────────────
YFINANCE_POLL_INTERVAL=300
YFINANCE_STALE_THRESHOLD=86400
ALERT_POLL_INTERVAL=3
